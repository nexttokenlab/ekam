APP_ENV=development
DATABASE_PATH=backend/data/talkeasy.sqlite3
FRONTEND_URL=http://localhost:5173
RETENTION_DAYS=30
# LiveKit Cloud or self-hosted URL and server credentials; never prefix secrets with VITE_.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Same random secret for FastAPI and the worker. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_SECRET=
BACKEND_URL=http://127.0.0.1:8017
SARVAM_API_KEY=
# Optional: Fish Audio key for the opt-in "Self" voice (learning, speaking, previews, removal).
# Set it on both the API and the worker. Leave empty to hide the feature.
FISH_API_KEY=
# Fish Audio speaking model: s2.1-pro (needs Fish Audio credit) or s2.1-pro-free.
FISH_TTS_MODEL=s2.1-pro
OPENAI_API_KEY=
GEMINI_API_KEY=
TRANSLATION_PROVIDER=gemini
TRANSLATION_MODEL=gemini-3.1-flash-lite
# Optional in development; required for production phone verification.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
ENABLE_BACKGROUND_VOICE_CANCELLATION=false

# Separate named workers when local and hosted environments share a LiveKit project.
LIVEKIT_AGENT_NAME=talkeasy-translator
AGENT_IDLE_PROCESSES=0
